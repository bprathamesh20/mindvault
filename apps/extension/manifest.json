{
  "manifest_version": 3,
  "name": "MindVault",
  "version": "0.1.0",
  "description": "Save any tab to MindVault with one click or a keyboard shortcut.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Add to MindVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage", "favicon", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "save-to-mindvault": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save the current tab to MindVault"
    }
  }
}
